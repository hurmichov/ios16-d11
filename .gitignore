# Apple firmware must never be committed.
# NOTE: these patterns match extracted firmware blobs, not our Python sources
# (halcyon/modules/kernelcache.py etc.) — those are force-added and negated below.
*.ipsw
*.im4p
*.img4
*.im4m
*.shsh
*.shsh2
*.dmg
*.aea
/kernelcache*
/DeviceTree*
/sep-firmware*
ipsw/
work/
extract/
# never ignore our own source tree
!halcyon/
!halcyon/**

# build
dist/
build/
*.egg-info/
__pycache__/
.pytest_cache/
firmware/rp2350-diag/build/
