# udev: стабильные имена портов адаптера d11diag
# sudo cp 60-d11diag.rules /etc/udev/rules.d/ && sudo udevadm control --reload
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="d110", ENV{ID_USB_INTERFACE_NUM}=="00", SYMLINK+="d11diag-uart", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="d110", ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="d11diag-events", MODE="0660", TAG+="uaccess"
