index 0000000..e49fdc2
--- /dev/null
+++ b/crates/victory-gpu/src/host/fsr.rs
@@ -0,0 +1,571 @@
+//! AMD FidelityFX Super Resolution 1 at the present (`VICTORY_FSR=1`): the
+//! world's picture, as the title made it, enlarged to the window's size by
+//! EASU (edge-adaptive spatial upsampling) and sharpened by RCAS (robust
+//! contrast-adaptive sharpening), in place of the copy or stretch the present
+//! did.
+//!
+//! What for: on a card too slow for the title's own sizes (a GTX 1660 at
+//! 1920x1080 on the Series S profile) the title is set to a smaller output
+//! (`VICTORY_OUTPUT=1280x720`, its own upscaler below that through
+//! `VICTORY_RENDER_SCALE`) and this pass brings it up to the screen. On a
+//! Series S present of two planes only the world (the bottom plane) goes
+//! through it; the interface is composed over the enlarged world at the
+//! window's size as before, so text and the HUD stay sharp.
+//!
+//! - `VICTORY_FSR=1` turns it on (off without it).
+//! - `VICTORY_FSR_OUTPUT=<w>x<h>`: the size shown (default: the primary
+//!   screen's). The picture keeps its aspect inside it; nothing is done when
+//!   it would not be larger than the title's.
+//! - `VICTORY_FSR_SHARPNESS=<stops>`: RCAS, 0 the sharpest to 2 (default
+//!   0.25; AMD's default is 0.2).
+//!
+//! The shaders follow AMD's `ffx_fsr1.h` (FidelityFX FSR 1.0, MIT; Copyright
+//! (c) 2021 Advanced Micro Devices, Inc.) in plain 32-bit float HLSL: EASU's
+//! twelve taps around the position, its direction and length analysis of
+//! the four nearest texels' luma, its Lanczos-2 approximation and the
+//! deringing clamp; RCAS's five taps and limit, without its noise detection.
+
+use super::*;
+
+/// The two passes: one vertex shader of a triangle over the target and the
+/// two pixel shaders, both reading texels (`Load`, edges clamped) of the one
+/// texture in the table.
+const FSR: &str = r#"
+#define RS "RootConstants(num32BitConstants = 8, b0), DescriptorTable(SRV(t0), visibility = SHADER_VISIBILITY_PIXEL)"
+cbuffer sizes : register(b0) {
+    float2 source;
+    float2 shown;
+    float sharpness;
+    float3 unused;
+};
+Texture2D<float4> picture : register(t0);
+struct Corner {
+    float4 at : SV_Position;
+};
+[RootSignature(RS)]
+Corner corner(uint i : SV_VertexID) {
+    Corner c;
+    float2 p = float2(float(i & 1) * 2.0, float(i >> 1) * 2.0);
+    c.at = float4(p.x * 2.0 - 1.0, 1.0 - p.y * 2.0, 0.0, 1.0);
+    return c;
+}
+float3 fetch(int2 p) {
+    int2 most = int2(source) - int2(1, 1);
+    return picture.Load(int3(clamp(p, int2(0, 0), most), 0)).rgb;
+}
+float luma(float3 c) {
+    return c.b * 0.5 + (c.r * 0.5 + c.g);
+}
+void easu_tap(inout float3 aC, inout float aW, float2 off, float2 dir, float2 len, float lob, float clp, float3 c) {
+    float2 v;
+    v.x = off.x * dir.x + off.y * dir.y;
+    v.y = off.x * -dir.y + off.y * dir.x;
+    v *= len;
+    float d2 = min(v.x * v.x + v.y * v.y, clp);
+    float wB = 2.0 / 5.0 * d2 - 1.0;
+    float wA = lob * d2 - 1.0;
+    wB *= wB;
+    wA *= wA;
+    wB = 25.0 / 16.0 * wB - (25.0 / 16.0 - 1.0);
+    float w = wB * wA;
+    aC += c * w;
+    aW += w;
+}
+void easu_set(inout float2 dir, inout float len, float w, float lA, float lB, float lC, float lD, float lE) {
+    float lenX = max(abs(lD - lC), abs(lC - lB));
+    lenX = 1.0 / max(lenX, 1.0 / 65536.0);
+    float dirX = lD - lB;
+    dir.x += dirX * w;
+    lenX = saturate(abs(dirX) * lenX);
+    lenX *= lenX;
+    len += lenX * w;
+    float lenY = max(abs(lE - lC), abs(lC - lA));
+    lenY = 1.0 / max(lenY, 1.0 / 65536.0);
+    float dirY = lE - lA;
+    dir.y += dirY * w;
+    lenY = saturate(abs(dirY) * lenY);
+    lenY *= lenY;
+    len += lenY * w;
+}
+[RootSignature(RS)]
+float4 easu(Corner c) : SV_Target {
+    //    b c
+    //  e f g h
+    //  i j k l
+    //    n o
+    float2 pp = c.at.xy * (source / shown) - 0.5;
+    float2 fp = floor(pp);
+    pp -= fp;
+    int2 at = int2(fp);
+    float3 b = fetch(at + int2(0, -1));
+    float3 cc = fetch(at + int2(1, -1));
+    float3 e = fetch(at + int2(-1, 0));
+    float3 f = fetch(at);
+    float3 g = fetch(at + int2(1, 0));
+    float3 h = fetch(at + int2(2, 0));
+    float3 i = fetch(at + int2(-1, 1));
+    float3 j = fetch(at + int2(0, 1));
+    float3 k = fetch(at + int2(1, 1));
+    float3 l = fetch(at + int2(2, 1));
+    float3 n = fetch(at + int2(0, 2));
+    float3 o = fetch(at + int2(1, 2));
+    float bL = luma(b), cL = luma(cc), eL = luma(e), fL = luma(f), gL = luma(g), hL = luma(h);
+    float iL = luma(i), jL = luma(j), kL = luma(k), lL = luma(l), nL = luma(n), oL = luma(o);
+    float2 dir = float2(0.0, 0.0);
+    float len = 0.0;
+    easu_set(dir, len, (1.0 - pp.x) * (1.0 - pp.y), bL, eL, fL, gL, jL);
+    easu_set(dir, len, pp.x * (1.0 - pp.y), cL, fL, gL, hL, kL);
+    easu_set(dir, len, (1.0 - pp.x) * pp.y, fL, iL, jL, kL, nL);
+    easu_set(dir, len, pp.x * pp.y, gL, jL, kL, lL, oL);
+    float dirR = dir.x * dir.x + dir.y * dir.y;
+    bool zero = dirR < 1.0 / 32768.0;
+    dirR = zero ? 1.0 : rsqrt(dirR);
+    dir.x = zero ? 1.0 : dir.x;
+    dir *= dirR;
+    len = len * 0.5;
+    len *= len;
+    float stretch = (dir.x * dir.x + dir.y * dir.y) / max(abs(dir.x), abs(dir.y));
+    float2 len2 = float2(1.0 + (stretch - 1.0) * len, 1.0 - 0.5 * len);
+    float lob = 0.5 + ((1.0 / 4.0 - 0.04) - 0.5) * len;
+    float clp = 1.0 / lob;
+    float3 mn = min(min(f, g), min(j, k));
+    float3 mx = max(max(f, g), max(j, k));
+    float3 aC = float3(0.0, 0.0, 0.0);
+    float aW = 0.0;
+    easu_tap(aC, aW, float2(0.0, -1.0) - pp, dir, len2, lob, clp, b);
+    easu_tap(aC, aW, float2(1.0, -1.0) - pp, dir, len2, lob, clp, cc);
+    easu_tap(aC, aW, float2(-1.0, 1.0) - pp, dir, len2, lob, clp, i);
+    easu_tap(aC, aW, float2(0.0, 1.0) - pp, dir, len2, lob, clp, j);
+    easu_tap(aC, aW, float2(0.0, 0.0) - pp, dir, len2, lob, clp, f);
+    easu_tap(aC, aW, float2(-1.0, 0.0) - pp, dir, len2, lob, clp, e);
+    easu_tap(aC, aW, float2(1.0, 1.0) - pp, dir, len2, lob, clp, k);
+    easu_tap(aC, aW, float2(2.0, 1.0) - pp, dir, len2, lob, clp, l);
+    easu_tap(aC, aW, float2(2.0, 0.0) - pp, dir, len2, lob, clp, h);
+    easu_tap(aC, aW, float2(1.0, 0.0) - pp, dir, len2, lob, clp, g);
+    easu_tap(aC, aW, float2(1.0, 2.0) - pp, dir, len2, lob, clp, o);
+    easu_tap(aC, aW, float2(0.0, 2.0) - pp, dir, len2, lob, clp, n);
+    float3 pix = abs(aW) < 1.0e-6 ? f : min(mx, max(mn, aC / aW));
+    return float4(pix, 1.0);
+}
+[RootSignature(RS)]
+float4 rcas(Corner c) : SV_Target {
+    //    b
+    //  d e f
+    //    h
+    int2 at = int2(c.at.xy);
+    float3 b = fetch(at + int2(0, -1));
+    float3 d = fetch(at + int2(-1, 0));
+    float3 e = fetch(at);
+    float3 f = fetch(at + int2(1, 0));
+    float3 h = fetch(at + int2(0, 1));
+    float3 mn4 = min(min(b, d), min(f, h));
+    float3 mx4 = max(max(b, d), max(f, h));
+    float3 hitMin = min(mn4, e) / max(4.0 * mx4, 1.0e-5);
+    float3 hitMax = (1.0 - max(mx4, e)) / min(4.0 * mn4 - 4.0, -1.0e-5);
+    float3 lobe3 = max(-hitMin, hitMax);
+    // FSR_RCAS_LIMIT: 0.25 - 1/16.
+    float lobe = max(-(0.25 - 1.0 / 16.0), min(max(lobe3.r, max(lobe3.g, lobe3.b)), 0.0)) * sharpness;
+    float3 pix = (lobe * (b + d + f + h) + e) / (4.0 * lobe + 1.0);
+    return float4(pix, 1.0);
+}
+"#;
+
+/// Whether the pass is asked for (`VICTORY_FSR`).
+pub(super) fn on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_FSR").is_some_and(|v| v != "0"))
+}
+
+/// RCAS's sharpening, as the pass is told it (`exp2(-stops)`).
+fn sharpness() -> f32 {
+    static SHARP: OnceLock<f32> = OnceLock::new();
+    *SHARP.get_or_init(|| {
+        let stops = std::env::var("VICTORY_FSR_SHARPNESS")
+            .ok()
+            .and_then(|v| v.trim().parse::<f32>().ok())
+            .filter(|s| s.is_finite())
+            .map_or(0.25, |s| s.clamp(0.0, 2.0));
+        (-stops).exp2()
+    })
+}
+
+/// The size asked to be shown (`VICTORY_FSR_OUTPUT`), else the primary
+/// screen's.
+fn screen() -> Option<(u32, u32)> {
+    static SIZE: OnceLock<Option<(u32, u32)>> = OnceLock::new();
+    *SIZE.get_or_init(|| {
+        let asked = std::env::var("VICTORY_FSR_OUTPUT")
+            .ok()
+            .and_then(|v| parse_size(&v));
+        let size = asked.or_else(|| {
+            // SAFETY: plain queries.
+            let (w, h) = unsafe { (GetSystemMetrics(SM_CXSCREEN), GetSystemMetrics(SM_CYSCREEN)) };
+            (w > 0 && h > 0).then_some((w as u32, h as u32))
+        });
+        tracing::info!(
+            ?size,
+            asked = asked.is_some(),
+            "FSR 1: the size it enlarges to (VICTORY_FSR_OUTPUT)"
+        );
+        size
+    })
+}
+
+pub(super) fn parse_size(text: &str) -> Option<(u32, u32)> {
+    let (w, h) = text.trim().split_once(['x', 'X'])?;
+    let size: (u32, u32) = (w.trim().parse().ok()?, h.trim().parse().ok()?);
+    ((320..=7680).contains(&size.0) && (180..=4320).contains(&size.1)).then_some(size)
+}
+
+/// The size a picture of `width` x `height` is shown at inside `room`: as
+/// large as fits with its aspect kept, at most three times as large, and
+/// the picture's own size when that would be no larger.
+pub(super) fn fit((width, height): (u32, u32), (room_w, room_h): (u32, u32)) -> (u32, u32) {
+    if width == 0 || height == 0 {
+        return (width, height);
+    }
+    let scale = (f64::from(room_w) / f64::from(width))
+        .min(f64::from(room_h) / f64::from(height))
+        .min(3.0);
+    if scale <= 1.0 {
+        return (width, height);
+    }
+    let shown = (
+        (f64::from(width) * scale).round() as u32,
+        (f64::from(height) * scale).round() as u32,
+    );
+    if shown.0 <= width && shown.1 <= height {
+        (width, height)
+    } else {
+        shown
+    }
+}
+
+/// The size a picture the title made of `size` is shown at: larger only
+/// with the pass on.
+pub(super) fn shown(size: (u32, u32)) -> (u32, u32) {
+    match (on(), screen()) {
+        (true, Some(room)) => fit(size, room),
+        _ => size,
+    }
+}
+
+/// EASU's and RCAS's pipelines for a target of `format` (`None`: the host
+/// refused; said once).
+fn pipelines(format: DXGI_FORMAT) -> Option<(PlanePipeline, ID3D12PipelineState)> {
+    type Made = (i32, Option<(PlanePipeline, ID3D12PipelineState)>);
+    static MADE: Mutex<Vec<Made>> = Mutex::new(Vec::new());
+    let mut made = MADE.lock().unwrap_or_else(|e| e.into_inner());
+    if let Some((_, pipelines)) = made.iter().find(|m| m.0 == format.0) {
+        return pipelines.clone();
+    }
+    let make = || -> windows::core::Result<(PlanePipeline, ID3D12PipelineState)> {
+        use windows::core::s;
+        let device = &host().ok_or_else(windows::core::Error::empty)?.device;
+        let vs = compile(FSR, s!("corner"), s!("vs_5_1"))?;
+        let easu = compile(FSR, s!("easu"), s!("ps_5_1"))?;
+        let rcas = compile(FSR, s!("rcas"), s!("ps_5_1"))?;
+        let code = |bytes: &[u8]| D3D12_SHADER_BYTECODE {
+            pShaderBytecode: bytes.as_ptr().cast(),
+            BytecodeLength: bytes.len(),
+        };
+        let mut targets = [DXGI_FORMAT_UNKNOWN; 8];
+        targets[0] = format;
+        // SAFETY: the root signature is inside the pixel shaders (the same
+        // one in both); the descriptions point at live data and never
+        // release their pointer.
+        unsafe {
+            let root: ID3D12RootSignature = device.CreateRootSignature(0, &easu[..])?;
+            let mut desc = D3D12_GRAPHICS_PIPELINE_STATE_DESC {
+                pRootSignature: std::mem::transmute_copy(&root),
+                VS: code(&vs[..]),
+                PS: code(&easu[..]),
+                SampleMask: u32::MAX,
+                RasterizerState: D3D12_RASTERIZER_DESC {
+                    FillMode: D3D12_FILL_MODE_SOLID,
+                    CullMode: D3D12_CULL_MODE_NONE,
+                    DepthClipEnable: true.into(),
+                    ..Default::default()
+                },
+                PrimitiveTopologyType: D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE,
+                NumRenderTargets: 1,
+                RTVFormats: targets,
+                SampleDesc: DXGI_SAMPLE_DESC {
+                    Count: 1,
+                    Quality: 0,
+                },
+                ..Default::default()
+            };
+            desc.BlendState.RenderTarget[0].RenderTargetWriteMask =
+                D3D12_COLOR_WRITE_ENABLE_ALL.0 as u8;
+            let easu: ID3D12PipelineState = device.CreateGraphicsPipelineState(&desc)?;
+            desc.PS = code(&rcas[..]);
+            let rcas: ID3D12PipelineState = device.CreateGraphicsPipelineState(&desc)?;
+            Ok(((root, easu), rcas))
+        }
+    };
+    let pipelines = match make() {
+        Ok(p) => {
+            tracing::info!(
+                format = format.0,
+                sharpness = sharpness(),
+                "FSR 1: EASU and RCAS pipelines made"
+            );
+            Some(p)
+        }
+        Err(e) => {
+            tracing::warn!(error = %e, format = format.0, "FSR 1: no pipelines; the picture is shown as before");
+            None
+        }
+    };
+    made.push((format.0, pipelines.clone()));
+    pipelines
+}
+
+/// A render target of the presenter's own, made again for another size or
+/// format.
+#[derive(Default)]
+pub(super) struct Target {
+    made: Option<(ID3D12Resource, u32, u32, i32)>,
+}
+
+impl Target {
+    /// The texture, in the render target state between uses.
+    pub(super) fn get(
+        &mut self,
+        (width, height): (u32, u32),
+        format: DXGI_FORMAT,
+    ) -> Option<ID3D12Resource> {
+        if let Some((texture, w, h, f)) = &self.made
+            && (*w, *h, *f) == (width, height, format.0)
+        {
+            return Some(texture.clone());
+        }
+        let host = host()?;
+        let desc = D3D12_RESOURCE_DESC {
+            Dimension: D3D12_RESOURCE_DIMENSION_TEXTURE2D,
+            Width: u64::from(width),
+            Height: height,
+            DepthOrArraySize: 1,
+            MipLevels: 1,
+            Format: format,
+            SampleDesc: DXGI_SAMPLE_DESC {
+                Count: 1,
+                Quality: 0,
+            },
+            Flags: D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET,
+            ..Default::default()
+        };
+        let heap = D3D12_HEAP_PROPERTIES {
+            Type: D3D12_HEAP_TYPE_DEFAULT,
+            ..Default::default()
+        };
+        let mut made: Option<ID3D12Resource> = None;
+        // SAFETY: plain creation.
+        let result = unsafe {
+            host.device.CreateCommittedResource(
+                &heap,
+                D3D12_HEAP_FLAG_NONE,
+                &desc,
+                D3D12_RESOURCE_STATE_RENDER_TARGET,
+                None,
+                &mut made,
+            )
+        };
+        if let Err(e) = result {
+            tracing::warn!(error = %e, width, height, "FSR 1: no texture of its own");
+            return None;
+        }
+        let texture = made?;
+        tracing::info!(
+            width,
+            height,
+            format = format.0,
+            "FSR 1: a texture of its own made"
+        );
+        // The one before stays alive in the lists that still hold it.
+        self.made = Some((texture.clone(), width, height, format.0));
+        Some(texture)
+    }
+}
+
+/// What the presenter keeps for the pass.
+#[derive(Default)]
+pub(super) struct Fsr {
+    /// EASU's output, RCAS's input: the shown size.
+    mid: Target,
+    /// For a present of planes: the world enlarged, composed under the rest.
+    pub(super) world: Target,
+    said: bool,
+}
+
+/// A shader resource view of `texture` in the plane pass's ring; its
+/// shader-visible handle.
+///
+/// # Safety
+/// A live texture; the ring's slot is not read by a frame still in flight
+/// (the ring is as large as the plane pass's).
+unsafe fn view(
+    host: &Host,
+    pass: &PlanePass,
+    texture: &ID3D12Resource,
+) -> D3D12_GPU_DESCRIPTOR_HANDLE {
+    // SAFETY: the caller's promise.
+    unsafe {
+        let of = texture.GetDesc();
+        let slot = pass.next.fetch_add(1, Ordering::Relaxed) % PLANE_VIEWS;
+        let desc = D3D12_SHADER_RESOURCE_VIEW_DESC {
+            Format: swap_format(of.Format)
+                .filter(|_| typeless(of.Format))
+                .unwrap_or(of.Format),
+            ViewDimension: D3D12_SRV_DIMENSION_TEXTURE2D,
+            Shader4ComponentMapping: D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING,
+            Anonymous: D3D12_SHADER_RESOURCE_VIEW_DESC_0 {
+                Texture2D: D3D12_TEX2D_SRV {
+                    MipLevels: 1,
+                    ..Default::default()
+                },
+            },
+        };
+        let cpu = D3D12_CPU_DESCRIPTOR_HANDLE {
+            ptr: pass.cpu + (slot * pass.step) as usize,
+        };
+        host.device
+            .CreateShaderResourceView(texture, Some(&desc), cpu);
+        D3D12_GPU_DESCRIPTOR_HANDLE {
+            ptr: pass.gpu + u64::from(slot * pass.step),
+        }
+    }
+}
+
+/// One full-target triangle of `pipeline` reading `source` into `target`.
+///
+/// # Safety
+/// An open list; live textures, `source` readable by pixel shaders and
+/// `target` a render target.
+#[allow(clippy::too_many_arguments)]
+unsafe fn pass(
+    host: &Host,
+    planes: &PlanePass,
+    list: &ID3D12GraphicsCommandList,
+    root: &ID3D12RootSignature,
+    pipeline: &ID3D12PipelineState,
+    source: &ID3D12Resource,
+    target: &ID3D12Resource,
+    sizes: [f32; 8],
+) {
+    let (width, height) = (sizes[2] as u32, sizes[3] as u32);
+    // SAFETY: the caller's promise.
+    unsafe {
+        let table = view(host, planes, source);
+        let rtv = host.rtv(Some(target), None);
+        list.SetDescriptorHeaps(&[Some(planes.views.clone())]);
+        list.SetGraphicsRootSignature(root);
+        list.SetPipelineState(pipeline);
+        list.OMSetRenderTargets(1, Some(&rtv), false, None);
+        list.RSSetViewports(&[D3D12_VIEWPORT {
+            TopLeftX: 0.0,
+            TopLeftY: 0.0,
+            Width: width as f32,
+            Height: height as f32,
+            MinDepth: 0.0,
+            MaxDepth: 1.0,
+        }]);
+        list.RSSetScissorRects(&[RECT {
+            left: 0,
+            top: 0,
+            right: width as i32,
+            bottom: height as i32,
+        }]);
+        list.IASetPrimitiveTopology(windows::Win32::Graphics::Direct3D::D3D_PRIMITIVE_TOPOLOGY(
+            4,
+        ));
+        list.SetGraphicsRoot32BitConstants(0, 8, sizes.as_ptr().cast(), 0);
+        list.SetGraphicsRootDescriptorTable(1, table);
+        list.DrawInstanced(3, 1, 0, 0);
+    }
+}
+
+impl Fsr {
+    /// Records into `keep`'s list EASU then RCAS: `source` (readable by
+    /// pixel shaders, and so left) enlarged into `target` (a render target
+    /// of `shown` in `format`, and so left). `false` if nothing was
+    /// recorded (the host refused a pipeline or a texture): then the caller
+    /// shows the picture as before.
+    pub(super) fn record(
+        &mut self,
+        keep: &HostList,
+        source: &ID3D12Resource,
+        target: &ID3D12Resource,
+        shown: (u32, u32),
+        format: DXGI_FORMAT,
+    ) -> bool {
+        let (Some(host), Some(planes), Some(((root, easu), rcas))) =
+            (host(), plane_pass(), pipelines(format))
+        else {
+            return false;
+        };
+        let Some(mid) = self.mid.get(shown, format) else {
+            return false;
+        };
+        // SAFETY: a live texture.
+        let of = unsafe { source.GetDesc() };
+        let sizes = [
+            of.Width as f32,
+            of.Height as f32,
+            shown.0 as f32,
+            shown.1 as f32,
+            sharpness(),
+            0.0,
+            0.0,
+            0.0,
+        ];
+        if !self.said {
+            self.said = true;
+            tracing::info!(
+                from_width = of.Width,
+                from_height = of.Height,
+                to_width = shown.0,
+                to_height = shown.1,
+                "FSR 1: the picture is enlarged at the present"
+            );
+        }
+        keep.keep(&mid);
+        let list = &keep.list;
+        let rt = D3D12_RESOURCE_STATE_RENDER_TARGET;
+        let read = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        // SAFETY: an open list; live textures in the states named (`mid`
+        // is a render target between uses).
+        unsafe {
+            pass(host, planes, list, &root, &easu, source, &mid, sizes);
+            list.ResourceBarrier(&[transition(&mid, rt, read)]);
+            let mut sharpen = sizes;
+            // RCAS reads the enlarged picture.
+            sharpen[0] = shown.0 as f32;
+            sharpen[1] = shown.1 as f32;
+            pass(host, planes, list, &root, &rcas, &mid, target, sharpen);
+            list.ResourceBarrier(&[transition(&mid, read, rt)]);
+        }
+        true
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{fit, parse_size};
+
+    #[test]
+    fn the_picture_is_fitted_larger_only() {
+        assert_eq!(fit((1280, 720), (1920, 1080)), (1920, 1080));
+        assert_eq!(fit((960, 540), (1280, 720)), (1280, 720));
+        // Its aspect kept inside a wider screen.
+        assert_eq!(fit((1280, 720), (2560, 1080)), (1920, 1080));
+        // Never smaller, never more than three times.
+        assert_eq!(fit((1920, 1080), (1280, 720)), (1920, 1080));
+        assert_eq!(fit((1920, 1080), (1920, 1080)), (1920, 1080));
+        assert_eq!(fit((640, 360), (3840, 2160)), (1920, 1080));
+        assert_eq!(parse_size("1920x1080"), Some((1920, 1080)));
+        assert_eq!(parse_size("1080p"), None);
+        assert_eq!(parse_size("10x10"), None);
+    }
+}
