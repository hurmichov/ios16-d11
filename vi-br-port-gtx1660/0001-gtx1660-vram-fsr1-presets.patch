+    if (width, height) != (3840, 2160) {
+        let mut new = POOL_CHECK_BYTES.to_vec();
+        new[6] = 0xeb; // jmp +1 over the int3, in place of jbe +1
+        patches.push(OwnedPatch {
+            what: "output size: back buffer pool's left-over check",
+            rva: POOL_CHECK_AT,
+            expect: POOL_CHECK_BYTES.to_vec(),
+            new,
+        });
+    }
+    patches
