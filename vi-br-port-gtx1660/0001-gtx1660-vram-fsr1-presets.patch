+# Starts the title with settings for a 6 GB NVIDIA card without ray-tracing cores
+# (GTX 1660 / 1660 Super / 1660 Ti; also RTX 2060 6 GB, RTX 3050 6 GB) on a 1080p screen.
+# docs/GTX1660.md says what each preset does and what was measured.
+#   scripts\play-gtx1660.ps1 -Exe <path of your own copy's executable> [-Preset perf540]
+# -Preset    perf540   the title at 1280x720 from ~960x540 (its own upscaler), FSR 1 to the screen (default)
+#            test720   the title at 1280x720 from 1280x720 (no upscaler of its own), FSR 1 to the screen
+#            half      Series S at half scale: the title at 1920x1080 from 960x540, no FSR
+#            native    this fork's own settings at 1920x1080 (2/3 scale), for comparison
+# -Screen    the size FSR 1 enlarges to (default: the primary screen's)
+# -Sharpness RCAS, 0 the sharpest to 2 (default 0.25)
+# -Build     target\diag (as play.ps1) or target\release
+# -More      other settings: -More @{VICTORY_PANEL='1'}
+# Run it from a normal window, not as administrator: the driver then keeps its shader cache elsewhere.
+param(
+    [Parameter(Mandatory)][string]$Exe,
+    [ValidateSet('perf540', 'test720', 'half', 'native')][string]$Preset = 'perf540',
+    [string]$Screen = '',
+    [double]$Sharpness = 0.25,
+    [ValidateSet('diag', 'release')][string]$Build = 'release',
+    [hashtable]$More = @{}
+)
+# This fork's measured settings (README.md, "How to run"), without the ones an NVIDIA card
+# runs slower with (VICTORY_THIN=1 halves the frame rate there).
+$settings = @{
+    VICTORY_TEXTURE_NO_WAIT = '1'; VICTORY_RELAY = '2'; VICTORY_WIDE_BACK = '1'; VICTORY_CARD_REHASH_RUNS = '1'
+    VICTORY_JOIN_COPIES = '1'; VICTORY_INDIRECT_WINDOW = '1'; VICTORY_RELAY_COPY = '1'; VICTORY_CARD_STEPS = '2'
+    VICTORY_INDIRECT_BATCH = '2'; VICTORY_MAP_THREADS = '1'; VICTORY_TITLE_PRIORITIES = '0'; VICTORY_CARD_AWAKE = '0'
+    VICTORY_SHOW_AFTER = '1'; VICTORY_AMBIENT = 'constant:0.1'; VICTORY_AMBIENT_AIR = '0.8'; VICTORY_CARD_BUFFERS_MIN_KB = '64'
+    VICTORY_PORT_CONSTANTS = '1'; VICTORY_D3D12_DRED = 'light'; VICTORY_SKIP_PIPELINES = 'none'
+    VICTORY_THIN = '0'; VICTORY_PIPELINE_BOOK = '1'; VICTORY_ASYNC_SUBMIT = '1'
+    # No ray tracing: a GTX 16 card has no cores for it. The ray test hits nothing, the skinning
+    # for the ray-tracing structure and the ray-traced shadow passes are left out.
+    VICTORY_RT_MISS = '1'; VICTORY_SKIP_RT_SHADOW = '1'
+    # The title's own upscaler (the FidelityFX passes have no DXIL here).
+    VICTORY_UPSCALER = '6'
+    # The console's display: a 1080p television (the interface plane is made at that size).
+    VICTORY_DISPLAY_MODE = '1920x1080'
+    # 6 GB card defaults (crates/victory-gpu/src/vram_tier.rs), even if the system reports a
+    # budget a little over 6.5 GB.
+    VICTORY_VRAM_TIER = '6gb'
+}
+switch ($Preset) {
+    'perf540' { $settings.VICTORY_OUTPUT = '1280x720'; $settings.VICTORY_RENDER_SCALE = '0.75'; $settings.VICTORY_FSR = '1' }
+    'test720' { $settings.VICTORY_OUTPUT = '1280x720'; $settings.VICTORY_RENDER_SCALE = '1.0'; $settings.VICTORY_FSR = '1' }
+    'half'    { $settings.VICTORY_OUTPUT = '1920x1080'; $settings.VICTORY_RENDER_SCALE = '0.5' }
+    'native'  { }
+}
+if ($settings.VICTORY_FSR) {
+    $settings.VICTORY_FSR_SHARPNESS = [string]::Format([cultureinfo]::InvariantCulture, '{0}', $Sharpness)
+    if ($Screen) { $settings.VICTORY_FSR_OUTPUT = $Screen }
+}
+foreach ($k in $More.Keys) { $settings[$k] = $More[$k] }
+
+$victory = Join-Path $PSScriptRoot "..\target\$Build\victory.exe"
+if (-not (Test-Path $victory)) { Write-Host "No $victory. Build it first (docs/GTX1660.md)."; return }
+if (-not (Test-Path $Exe)) { Write-Host "No $Exe."; return }
+# (Other settings left over in this window go; where your files are stays.)
+$paths = 'VICTORY_CONFIG', 'VICTORY_GAME_DIR', 'VICTORY_CACHE_DIR', 'VICTORY_DATA_DIR'
+Get-ChildItem Env:VICTORY_* | Where-Object { $_.Name -notin $paths } | ForEach-Object { Remove-Item "Env:$($_.Name)" }
+foreach ($k in $settings.Keys) { Set-Item "Env:$k" $settings[$k] }
+Write-Host "Preset ${Preset}:" (($settings.Keys | Where-Object { $_ -match 'OUTPUT|SCALE|FSR|TIER' } | Sort-Object | ForEach-Object { "$_=$($settings[$_])" }) -join ' ')
+$Exe = (Resolve-Path $Exe).Path
+Push-Location (Join-Path $PSScriptRoot '..')   # victory.toml is looked for here
+try { & $victory run $Exe --console series-s --execute } finally { Pop-Location }
