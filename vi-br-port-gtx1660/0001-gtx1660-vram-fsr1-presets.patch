@@ -0,0 +1,114 @@
+//! Defaults for cards with 6 GB of their own memory or less (GTX 1660 /
+//! 1660 Super / 1660 Ti, RTX 2060 6 GB, RTX 3050 6 GB, laptop RTX 4050):
+//! `VICTORY_VRAM_TIER`.
+//!
+//! This fork's defaults are measured on an 8 GB card. On a 6 GB one the
+//! system's budget for the process is about 5.6 to 5.9 GB, and the 8 GB
+//! defaults (3 GB kept for render targets, 4 GB of buffer copies on the
+//! card, texture copies up to nine tenths of the budget) push the card past
+//! it: the system then moves memory into the PC's, and a frame takes several
+//! times as long. With a small card each such default becomes the one the
+//! Protonida fork (deynesdev/Protonida, 6 GB RTX 4050) ran stably with, after
+//! its "Kelvaroq 6 GB" budget set. An explicit `VICTORY_*` setting still
+//! wins over every one of them.
+//!
+//! `VICTORY_VRAM_TIER`: `auto` (the default: small when the budget is at most
+//! [`SMALL_MOST`]), `6gb` (small whatever the card says), `off` (this fork's
+//! defaults as before).
+
+/// The largest budget still taken as a 6 GB card's (8 GB cards report
+/// about 7.2 to 7.6 GB).
+pub(crate) const SMALL_MOST: u64 = 6656 << 20;
+
+const MIB: u64 = 1 << 20;
+
+/// What `VICTORY_VRAM_TIER` asks: `Some(true)` small, `Some(false)` not,
+/// `None` decided by the budget.
+fn forced() -> Option<bool> {
+    static FORCED: std::sync::OnceLock<Option<bool>> = std::sync::OnceLock::new();
+    *FORCED.get_or_init(|| parse_tier(std::env::var("VICTORY_VRAM_TIER").ok().as_deref()))
+}
+
+pub(crate) fn parse_tier(text: Option<&str>) -> Option<bool> {
+    match text?.trim().to_ascii_lowercase().as_str() {
+        "6" | "6gb" | "small" | "1" => Some(true),
+        "off" | "0" | "normal" | "8gb" => Some(false),
+        _ => None,
+    }
+}
+
+/// Whether a card with this budget (`None`: not known yet) gets the small
+/// card's defaults.
+pub(crate) fn small(budget: Option<u64>) -> bool {
+    decide(forced(), budget)
+}
+
+pub(crate) fn decide(forced: Option<bool>, budget: Option<u64>) -> bool {
+    forced.unwrap_or_else(|| budget.is_some_and(|b| b <= SMALL_MOST))
+}
+
+/// The most bytes of card copies of title buffers (`VICTORY_CARD_BUFFERS_MB`):
+/// 512 MiB where 8 GB cards take 1 GiB.
+pub(crate) const CARD_BUFFERS_MB: u64 = 512;
+/// Texture copies for shaders that pick textures by index
+/// (`VICTORY_TEXTURE_BUDGET_MB`): at most 512 MiB.
+pub(crate) const TEXTURE_BUDGET: u64 = 512 * MIB;
+/// Kept for render targets (`VICTORY_CARD_ROOM_FOR_TARGETS_MB`): 2,304 MiB
+/// where 8 GB cards keep 3,072.
+pub(crate) const ROOM_FOR_TARGETS: u64 = 2304 * MIB;
+/// Shader-visible memory on the card (`VICTORY_MEMORY_CARD_MB`): 768 MiB
+/// where 8 GB cards take 4 GiB.
+pub(crate) const MEMORY_CARD: u64 = 768 * MIB;
+/// Texture bytes staged a frame (`VICTORY_TEXTURE_STAGE_MB`): 64 MiB.
+pub(crate) const TEXTURE_STAGE: u64 = 64 * MIB;
+
+/// The budget the system gives this process on the card, if the host
+/// device is made.
+#[cfg(windows)]
+pub(crate) fn host_budget() -> Option<u64> {
+    crate::host::host()
+        .and_then(|h| h.video_memory())
+        .map(|[budget, ..]| budget)
+}
+
+/// Says once in the log which defaults are in use.
+pub(crate) fn say_once(budget: Option<u64>) {
+    static SAID: std::sync::Once = std::sync::Once::new();
+    if budget.is_none() && forced().is_none() {
+        return;
+    }
+    SAID.call_once(|| {
+        let small = small(budget);
+        tracing::info!(
+            budget_mb = budget.map(|b| b >> 20),
+            small,
+            "VRAM tier: {} (VICTORY_VRAM_TIER=auto|6gb|off)",
+            if small {
+                "6 GB card defaults"
+            } else {
+                "this fork's 8 GB defaults"
+            }
+        );
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    const GIB: u64 = 1 << 30;
+
+    #[test]
+    fn the_tier_is_told_or_taken_from_the_budget() {
+        assert_eq!(parse_tier(Some("6GB")), Some(true));
+        assert_eq!(parse_tier(Some(" off ")), Some(false));
+        assert_eq!(parse_tier(Some("auto")), None);
+        assert_eq!(parse_tier(None), None);
+        // A GTX 1660's budget is some 5.7 GB; an 8 GB card's some 7.3 GB.
+        assert!(decide(None, Some(5836 * MIB)));
+        assert!(decide(None, Some(6 * GIB)));
+        assert!(!decide(None, Some(7475 * MIB)));
+        assert!(!decide(None, None), "not known yet: the usual defaults");
+        assert!(decide(Some(true), Some(24 * GIB)));
+        assert!(!decide(Some(false), Some(4 * GIB)));
+    }
+}
